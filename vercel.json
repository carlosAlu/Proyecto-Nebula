{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "Backend",
      "framework": "express"
    },
    "frontend": {
      "root": "Frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/app.jsx"
    },
    {
      "source": "/api/(.*)",
      "destination": "/backend"
    }
  ]
}